# Ключ для жюри (заголовок X-API-Key). Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
API_KEY=
DATA_DIR=data
MAX_UPLOAD_MB=300
WORKERS=2
JOB_TIMEOUT_SEC=280
# baseline (без модели) или videojev (GPU). Для videojev см. ../ml/README.md
DETECTOR=baseline
VIDEOJEV_MODEL=/models/videojev-4b-fp16
# Дообученная голова и пороги (ml/train_head.py, ml/calibrate.py); пусто — исходная голова
VIDEOJEV_HEAD=
VIDEOJEV_THRESHOLDS=/models/thresholds.json
